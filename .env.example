# PostgreSQL (used by docker-compose.yml and Prisma)
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=library
DATABASE_URL=postgresql://library:library@localhost:5432/library?schema=public

# API
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Next.js reader/admin apps
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Required outside local development so Open Library can identify the service.
OPEN_LIBRARY_USER_AGENT=MyLibrary/1.0 (contact@example.com)
